# Copy to ".env.local" for local dev (vercel dev), or set these in the
# Vercel dashboard under Project -> Settings -> Environment Variables.

# Google Gemini — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Resend — get a key at https://resend.com/api-keys
RESEND_API_KEY=
# For testing you can leave EMAIL_FROM unset (defaults to onboarding@resend.dev,
# which only delivers to your own Resend account email). For production, verify a
# domain in Resend and use e.g. "Plans <plans@yourdomain.com>".
EMAIL_FROM=
