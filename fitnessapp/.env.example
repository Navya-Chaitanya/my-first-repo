# Server Settings
PORT=3000

# Gemini API Key (Get one from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# Email SMTP Settings (e.g. Gmail, Mailtrap, Resend, SendGrid, etc.)
# If left blank, the app will automatically use an ephemeral Ethereal mail account
# and log the inbox link to the console and display it in the app UI for testing!
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
